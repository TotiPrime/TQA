
pipeline {
    agent any

    options {
        skipDefaultCheckout()
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 10, unit: 'MINUTES')
    }

    stages {
        stage('1. Descargar codigo') {
            steps {
                deleteDir()
                checkout scm
            }
        }

        stage('2. Verificar Node.js') {
            steps {
                bat 'node --version'
            }
        }

        stage('3. Ejecutar pruebas') {
            steps {
                dir('IA-con-Criterio') {
                    bat 'node scripts/run-ci.mjs'
                }
            }
        }
    }

    post {
        always {
            script {
                def reporte = 'IA-con-Criterio/reports/junit.xml'

                if (fileExists(reporte)) {
                    junit testResults: reporte,
                          allowEmptyResults: false

                    archiveArtifacts(
                        artifacts: reporte,
                        fingerprint: true
                    )
                } else {
                    echo 'No se genero el reporte JUnit.'
                }
            }
        }

        success {
            echo 'Pruebas finalizadas correctamente.'
        }

        failure {
            echo 'La ejecucion presento errores.'
        }
    }
}
